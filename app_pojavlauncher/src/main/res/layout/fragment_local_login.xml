<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fok_screen_background"
    android:paddingHorizontal="@dimen/fragment_padding_medium">

    <ImageView
        android:id="@+id/fok_login_background_art"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:alpha="0.96"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/fok_seal_illustration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/fok_login_brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="@string/fok_brand_title"
        android:textColor="@color/primary_text"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/fok_login_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/fok_brand_subtitle"
        android:textColor="@color/secondary_text"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/fok_login_brand"
        app:layout_constraintStart_toStartOf="@id/fok_login_brand"
        app:layout_constraintTop_toBottomOf="@id/fok_login_brand" />

    <TextView
        android:id="@+id/fok_login_caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/fok_login_caption"
        android:textColor="@color/secondary_text"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/fok_login_brand"
        app:layout_constraintStart_toStartOf="@id/fok_login_brand"
        app:layout_constraintTop_toBottomOf="@id/fok_login_subtitle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/login_menu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/fok_panel_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fok_login_caption">

        <TextView
            android:id="@+id/login_username_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/login_online_username_hint"
            android:textColor="@color/secondary_text"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.kdt.mcgui.MineEditText
            android:id="@+id/login_edit_email"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginTop="8dp"
            android:imeOptions="flagNoExtractUi"
            android:inputType="text"
            android:textSize="@dimen/_16ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/login_username_label" />

        <TextView
            android:id="@+id/login_password_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fok_password_label"
            android:textColor="@color/secondary_text"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/login_edit_email" />

        <com.kdt.mcgui.MineEditText
            android:id="@+id/login_edit_password"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginTop="8dp"
            android:imeOptions="flagNoExtractUi"
            android:inputType="textPassword"
            android:textSize="@dimen/_16ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/login_password_label" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/login_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/_46sdp"
            android:layout_marginTop="18dp"
            android:text="@string/login_online_login_label"
            android:textColor="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/login_edit_password" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
