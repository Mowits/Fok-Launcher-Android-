<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fok_server_name_label" />

    <EditText
        android:id="@+id/fok_server_name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPersonName" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/fok_server_addr_label" />

    <EditText
        android:id="@+id/fok_server_addr_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="example.org:25565"
        android:inputType="textUri" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/fok_server_voice_label" />

    <EditText
        android:id="@+id/fok_server_voice_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="opsiyonel-oda-adi"
        android:inputType="text" />

</LinearLayout>
